  "operational_target": {
    "path": "C:\\neutra-hmc-surrogate\\surrogate_training\\experiments\\cai_lib.py",
    "sha256": "1b5fe93fb06181420749a4a9f985846fefac93615828d51ed9f2cbab64567b12",
    "source_excerpts": [
      {
        "start_line": 170,
        "end_line": 210,
        "lines": [
          {
            "line": 170,
            "text": "def load_cnf(cnf_path, dim_theta=6, dim_y=20, n_layers=8, hidden_dim=128):"
          },
          {
            "line": 171,
            "text": "    cnf = ConditionalRealNVP(dim_theta, dim_y, n_layers, hidden_dim).to(DEV)"
          },
          {
            "line": 172,
            "text": "    state = torch.load(cnf_path, map_location=DEV, weights_only=True)"
          },
          {
            "line": 173,
            "text": "    cnf.load_state_dict(state)"
          },
          {
            "line": 174,
            "text": "    cnf.eval()"
          },
          {
            "line": 175,
            "text": "    return cnf"
          },
          {
            "line": 176,
            "text": ""
          },
          {
            "line": 177,
            "text": ""
          },
          {
            "line": 178,
            "text": "# \u2500\u2500 Log-posterior on K (\u2264 M) measured modes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
          },
          {
            "line": 179,
            "text": "class KModeLogPosterior(nn.Module):"
          },
          {
            "line": 180,
            "text": "    \"\"\"Log posterior using only the first K modes from the surrogate output."
          },
          {
            "line": 181,
            "text": ""
          },
          {
            "line": 182,
            "text": "    log \u03c0(\u03b8|y) = -0.5/\u03ba\u00b2 \u03a3_{i=1..K} ((f_pred_i - y_i) / y_i)\u00b2 + log-normal prior"
          },
          {
            "line": 183,
            "text": "    \"\"\""
          },
          {
            "line": 184,
            "text": ""
          },
          {
            "line": 185,
            "text": "    def __init__(self, surrogate, observed_freqs, kappa_sq=1e-3, prior_sigma=0.3):"
          },
          {
            "line": 186,
            "text": "        super().__init__()"
          },
          {
            "line": 187,
            "text": "        self.surrogate = surrogate"
          },
          {
            "line": 188,
            "text": "        self.K = len(observed_freqs)"
          },
          {
            "line": 189,
            "text": "        self.register_buffer(\"f_obs\","
          },
          {
            "line": 190,
            "text": "                             torch.tensor(observed_freqs, dtype=torch.float32))"
          },
          {
            "line": 191,
            "text": "        self.kappa_sq = kappa_sq"
          },
          {
            "line": 192,
            "text": "        self.prior_sigma = prior_sigma"
          },
          {
            "line": 193,
            "text": ""
          },
          {
            "line": 194,
            "text": "    def forward(self, theta):"
          },
          {
            "line": 195,
            "text": "        if theta.dim() == 1:"
          },
          {
            "line": 196,
            "text": "            theta = theta.unsqueeze(0)"
          },
          {
            "line": 197,
            "text": "        f_pred = self.surrogate(theta)[:, :self.K]"
          },
          {
            "line": 198,
            "text": "        resid = (f_pred - self.f_obs) / self.f_obs"
          },
          {
            "line": 199,
            "text": "        ll = -0.5 / self.kappa_sq * (resid ** 2).sum(dim=-1)"
          },
          {
            "line": 200,
            "text": "        if (theta <= 0).any(dim=-1).any():"
          },
          {
            "line": 201,
            "text": "            lp = torch.full_like(ll, -1e30)"
          },
          {
            "line": 202,
            "text": "            valid = (theta > 0).all(dim=-1)"
          },
          {
            "line": 203,
            "text": "            log_t = torch.log(theta[valid].clamp(min=1e-30))"
          },
          {
            "line": 204,
            "text": "            lp[valid] = ll[valid] + ("
          },
          {
            "line": 205,
            "text": "                -0.5 * (log_t / self.prior_sigma) ** 2 - log_t"
          },
          {
            "line": 206,
            "text": "            ).sum(dim=-1)"
          },
          {
            "line": 207,
            "text": "            return lp"
          },
          {
            "line": 208,
            "text": "        log_t = torch.log(theta)"
          },
          {
            "line": 209,
            "text": "        lp_prior = (-0.5 * (log_t / self.prior_sigma) ** 2 - log_t).sum(dim=-1)"
          },
          {
            "line": 210,
            "text": "        return ll + lp_prior"
          }
        ]
      }
