{
  "original_d6_training": {
    "path": "C:\\nf-pmcmc\\experiments\\corrected_amortized.py",
    "sha256": "ea6726da9e5ef71a80741b6f073d49f905b99d8b4ae7155158a582ffd8cf432a",
    "source_excerpts": [
      {
        "start_line": 262,
        "end_line": 296,
        "lines": [
          {
            "line": 262,
            "text": "def generate_training_data(surrogate, n_train=50000, n_val=5000,"
          },
          {
            "line": 263,
            "text": "                           kappa=math.sqrt(1e-3), prior_sigma=0.3):"
          },
          {
            "line": 264,
            "text": "    \"\"\""
          },
          {
            "line": 265,
            "text": "    Generate (\u03b8, y) pairs by:"
          },
          {
            "line": 266,
            "text": "      1. Sample \u03b8 ~ p(\u03b8) = LogNormal(0, \u03c3\u00b2)"
          },
          {
            "line": 267,
            "text": "      2. Compute y = f\u0302(\u03b8) + \u03b5,  \u03b5 ~ N(0, \u03ba\u00b2\u00b7diag(y\u00b2))"
          },
          {
            "line": 268,
            "text": ""
          },
          {
            "line": 269,
            "text": "    This creates a dataset of observation-parameter pairs that the"
          },
          {
            "line": 270,
            "text": "    conditional NF will learn to invert."
          },
          {
            "line": 271,
            "text": "    \"\"\""
          },
          {
            "line": 272,
            "text": "    print(f\"  Generating {n_train + n_val} (\u03b8, y) pairs...\")"
          },
          {
            "line": 273,
            "text": ""
          },
          {
            "line": 274,
            "text": "    all_theta = []"
          },
          {
            "line": 275,
            "text": "    all_y = []"
          },
          {
            "line": 276,
            "text": ""
          },
          {
            "line": 277,
            "text": "    total = n_train + n_val"
          },
          {
            "line": 278,
            "text": "    batch_size = 2000"
          },
          {
            "line": 279,
            "text": ""
          },
          {
            "line": 280,
            "text": "    with torch.no_grad():"
          },
          {
            "line": 281,
            "text": "        for start in range(0, total, batch_size):"
          },
          {
            "line": 282,
            "text": "            end = min(start + batch_size, total)"
          },
          {
            "line": 283,
            "text": "            B = end - start"
          },
          {
            "line": 284,
            "text": ""
          },
          {
            "line": 285,
            "text": "            # Sample \u03b8 from log-normal prior"
          },
          {
            "line": 286,
            "text": "            log_theta = prior_sigma * torch.randn(B, D, device=DEV)"
          },
          {
            "line": 287,
            "text": "            theta = torch.exp(log_theta)"
          },
          {
            "line": 288,
            "text": ""
          },
          {
            "line": 289,
            "text": "            # Compute clean frequencies"
          },
          {
            "line": 290,
            "text": "            f_clean = surrogate(theta)  # (B, M)"
          },
          {
            "line": 291,
            "text": ""
          },
          {
            "line": 292,
            "text": "            # Add relative Gaussian noise"
          },
          {
            "line": 293,
            "text": "            noise = kappa * f_clean * torch.randn_like(f_clean)"
          },
          {
            "line": 294,
            "text": "            y = f_clean + noise"
          },
          {
            "line": 295,
            "text": ""
          },
          {
            "line": 296,
            "text": "            all_theta.append(theta)"
          }
        ]
      }
    ]
  },
  "calibration_script": {
    "path": "C:\\neutra-hmc-surrogate\\surrogate_training\\revision_experiments\\E4_calibration_sbc\\e4_coverage_sbc.py",
    "sha256": "2a1b0900a5d5aede2908cc2f79fcedce419aa828fa3861921ab0c6d942165d67",
    "source_excerpts": [
      {
        "start_line": 1,
        "end_line": 100,
        "lines": [
          {
            "line": 1,
            "text": "\"\"\""
          },
          {
            "line": 2,
            "text": "E4 (Step 6): posterior calibration \u2014 coverage + SBC (R1#14)."
          },
          {
            "line": 3,
            "text": ""
          },
          {
            "line": 4,
            "text": "Config: D=6 ORIGINAL surrogate + CNF (conditional_flow.pt). For a VALID calibration"
          },
          {
            "line": 5,
            "text": "test the test prior must equal the CNF's training prior, so we use the training"
          },
          {
            "line": 6,
            "text": "prior sigma=0.30 and training noise kappa=sqrt(1e-3)=3.16% (the manual's \"sigma=0.5,"
          },
          {
            "line": 7,
            "text": "kappa=3%\" would probe outside the training distribution and is not a valid SBC)."
          },
          {
            "line": 8,
            "text": ""
          },
          {
            "line": 9,
            "text": "Coverage: 100 theta~prior, y=f_hat(theta)+noise; fast-mode 50%/90% central credible"
          },
          {
            "line": 10,
            "text": "intervals; fraction covering the truth (expect ~0.50 / ~0.90). 10 exact-mode spot checks."
          },
          {
            "line": 11,
            "text": "SBC: 500 prior-predictive (theta,y); L=100 fast-mode draws; rank of truth per param;"
          },
          {
            "line": 12,
            "text": "rank histograms + ECDF-difference plot with 95% envelope."
          },
          {
            "line": 13,
            "text": "\"\"\""
          },
          {
            "line": 14,
            "text": "import sys, json"
          },
          {
            "line": 15,
            "text": "from pathlib import Path"
          },
          {
            "line": 16,
            "text": "import numpy as np, torch"
          },
          {
            "line": 17,
            "text": "torch.set_num_threads(4)"
          },
          {
            "line": 18,
            "text": "sys.path.insert(0, r\"C:\\neutra-hmc-surrogate\\surrogate_training\\revision_experiments\")"
          },
          {
            "line": 19,
            "text": "import revlib as R"
          },
          {
            "line": 20,
            "text": "import matplotlib; matplotlib.use(\"Agg\")"
          },
          {
            "line": 21,
            "text": "import matplotlib.pyplot as plt"
          },
          {
            "line": 22,
            "text": ""
          },
          {
            "line": 23,
            "text": "HERE = Path(__file__).resolve().parent"
          },
          {
            "line": 24,
            "text": "torch.manual_seed(42); np.random.seed(42)"
          },
          {
            "line": 25,
            "text": "SIGMA, KAPPA = 0.30, np.sqrt(1e-3)"
          },
          {
            "line": 26,
            "text": "sur = R.load_d6(); cnf = R.load_d6_cnf()"
          },
          {
            "line": 27,
            "text": "PN = [\"e1\", \"e2\", \"e3\", \"e4\", \"e5\", \"e6\"]"
          },
          {
            "line": 28,
            "text": ""
          },
          {
            "line": 29,
            "text": "def draw_theta(n):"
          },
          {
            "line": 30,
            "text": "    return np.clip(np.exp(SIGMA * np.random.randn(n, 6)), 0.5, 2.0)"
          },
          {
            "line": 31,
            "text": ""
          },
          {
            "line": 32,
            "text": "def gen_y(theta):"
          },
          {
            "line": 33,
            "text": "    with torch.no_grad():"
          },
          {
            "line": 34,
            "text": "        f = sur(torch.tensor(theta, dtype=torch.float32)).numpy()"
          },
          {
            "line": 35,
            "text": "    return f + KAPPA * np.abs(f) * np.random.randn(*f.shape)"
          },
          {
            "line": 36,
            "text": ""
          },
          {
            "line": 37,
            "text": "def fast_samples(y, N):"
          },
          {
            "line": 38,
            "text": "    return cnf.sample(torch.tensor(y, dtype=torch.float32), n_samples=N).numpy()"
          },
          {
            "line": 39,
            "text": ""
          },
          {
            "line": 40,
            "text": "# \u2500\u2500 Coverage \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
          },
          {
            "line": 41,
            "text": "NCOV = 100"
          },
          {
            "line": 42,
            "text": "th_cov = draw_theta(NCOV); y_cov = gen_y(th_cov)"
          },
          {
            "line": 43,
            "text": "cov50 = np.zeros(6); cov90 = np.zeros(6)"
          },
          {
            "line": 44,
            "text": "for i in range(NCOV):"
          },
          {
            "line": 45,
            "text": "    s = fast_samples(y_cov[i], 2000)"
          },
          {
            "line": 46,
            "text": "    lo50, hi50 = np.quantile(s, [0.25, 0.75], axis=0)"
          },
          {
            "line": 47,
            "text": "    lo90, hi90 = np.quantile(s, [0.05, 0.95], axis=0)"
          },
          {
            "line": 48,
            "text": "    cov50 += (th_cov[i] >= lo50) & (th_cov[i] <= hi50)"
          },
          {
            "line": 49,
            "text": "    cov90 += (th_cov[i] >= lo90) & (th_cov[i] <= hi90)"
          },
          {
            "line": 50,
            "text": "cov50 /= NCOV; cov90 /= NCOV"
          },
          {
            "line": 51,
            "text": "print(\"Coverage 50%:\", cov50.round(3), \" overall\", cov50.mean().round(3))"
          },
          {
            "line": 52,
            "text": "print(\"Coverage 90%:\", cov90.round(3), \" overall\", cov90.mean().round(3))"
          },
          {
            "line": 53,
            "text": ""
          },
          {
            "line": 54,
            "text": "# \u2500\u2500 Exact-mode spot checks (10) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
          },
          {
            "line": 55,
            "text": "exact_cov90 = []"
          },
          {
            "line": 56,
            "text": "for i in range(10):"
          },
          {
            "line": 57,
            "text": "    y_t = torch.tensor(y_cov[i], dtype=torch.float32)"
          },
          {
            "line": 58,
            "text": "    lp = R.make_log_post(sur, y_cov[i], \"d6\")"
          },
          {
            "line": 59,
            "text": "    smp = R.NeuTraHMC_Conditional(lp.forward, cnf, y_t, step_size=0.05, n_leapfrog=20)"
          },
          {
            "line": 60,
            "text": "    chain, ar = smp.run(torch.ones(6), n_samples=300, n_burnin=150)"
          },
          {
            "line": 61,
            "text": "    ch = chain.numpy()"
          },
          {
            "line": 62,
            "text": "    lo, hi = np.quantile(ch, [0.05, 0.95], axis=0)"
          },
          {
            "line": 63,
            "text": "    exact_cov90.append(((th_cov[i] >= lo) & (th_cov[i] <= hi)).mean())"
          },
          {
            "line": 64,
            "text": "exact_cov90 = float(np.mean(exact_cov90))"
          },
          {
            "line": 65,
            "text": "print(f\"Exact-mode 90% coverage (10 spot checks, per-obs avg): {exact_cov90:.3f}\")"
          },
          {
            "line": 66,
            "text": ""
          },
          {
            "line": 67,
            "text": "# \u2500\u2500 SBC \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
          },
          {
            "line": 68,
            "text": "NSBC, L = 500, 100"
          },
          {
            "line": 69,
            "text": "th_sbc = draw_theta(NSBC); y_sbc = gen_y(th_sbc)"
          },
          {
            "line": 70,
            "text": "ranks = np.zeros((NSBC, 6), dtype=int)"
          },
          {
            "line": 71,
            "text": "for i in range(NSBC):"
          },
          {
            "line": 72,
            "text": "    s = fast_samples(y_sbc[i], L)"
          },
          {
            "line": 73,
            "text": "    ranks[i] = (s < th_sbc[i]).sum(axis=0)          # rank in 0..L"
          },
          {
            "line": 74,
            "text": "print(\"SBC ranks computed; mean rank/L =\", (ranks.mean(0)/L).round(3))"
          },
          {
            "line": 75,
            "text": ""
          },
          {
            "line": 76,
            "text": "# rank histograms"
          },
          {
            "line": 77,
            "text": "fig, axes = plt.subplots(2, 3, figsize=(11, 5.5))"
          },
          {
            "line": 78,
            "text": "nbins = 20"
          },
          {
            "line": 79,
            "text": "for d, ax in enumerate(axes.ravel()):"
          },
          {
            "line": 80,
            "text": "    ax.hist(ranks[:, d], bins=nbins, range=(0, L), color=\"#4c72b0\", alpha=0.85)"
          },
          {
            "line": 81,
            "text": "    exp = NSBC / nbins"
          },
          {
            "line": 82,
            "text": "    band = 1.96 * np.sqrt(exp * (1 - 1/nbins))"
          },
          {
            "line": 83,
            "text": "    ax.axhline(exp, color=\"k\", lw=1)"
          },
          {
            "line": 84,
            "text": "    ax.axhspan(exp - band, exp + band, color=\"grey\", alpha=0.25)"
          },
          {
            "line": 85,
            "text": "    ax.set_title(f\"{PN[d]}\"); ax.set_xlabel(\"rank\")"
          },
          {
            "line": 86,
            "text": "fig.suptitle(f\"E4 SBC rank histograms (N={NSBC}, L={L}, D=6 original, sigma={SIGMA})\")"
          },
          {
            "line": 87,
            "text": "fig.tight_layout(); fig.savefig(HERE / \"E4_sbc_ranks.png\", dpi=150)"
          },
          {
            "line": 88,
            "text": "fig.savefig(HERE / \"E4_sbc_ranks.pdf\")"
          },
          {
            "line": 89,
            "text": ""
          },
          {
            "line": 90,
            "text": "# ECDF-difference plot with 95% envelope"
          },
          {
            "line": 91,
            "text": "fig2, ax = plt.subplots(figsize=(6.5, 4.2))"
          },
          {
            "line": 92,
            "text": "grid = np.linspace(0, 1, 200)"
          },
          {
            "line": 93,
            "text": "for d in range(6):"
          },
          {
            "line": 94,
            "text": "    u = (ranks[:, d] + 0.5) / (L + 1)"
          },
          {
            "line": 95,
            "text": "    ecdf = np.array([(u <= g).mean() for g in grid])"
          },
          {
            "line": 96,
            "text": "    ax.plot(grid, ecdf - grid, lw=1, label=PN[d])"
          },
          {
            "line": 97,
            "text": "band = 1.36 / np.sqrt(NSBC)          # KS 95%"
          },
          {
            "line": 98,
            "text": "ax.axhspan(-band, band, color=\"grey\", alpha=0.25, label=\"95% envelope\")"
          },
          {
            "line": 99,
            "text": "ax.axhline(0, color=\"k\", lw=0.8)"
          },
          {
            "line": 100,
            "text": "ax.set_xlabel(\"normalised rank\"); ax.set_ylabel(\"ECDF - uniform\")"
          }
        ]
      }
    ]
  },
