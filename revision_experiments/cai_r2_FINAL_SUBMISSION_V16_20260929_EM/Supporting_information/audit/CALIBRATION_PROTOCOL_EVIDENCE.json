    "source_excerpts": [
      {
        "start_line": 54,
        "end_line": 75,
        "lines": [
          {
            "line": 54,
            "text": "def nuts_narrow(init, nsamp=500, seed=0):"
          },
          {
            "line": 55,
            "text": "    yt = torch.tensor(y6)"
          },
          {
            "line": 56,
            "text": "    def U(p):"
          },
          {
            "line": 57,
            "text": "        z = p[\"z\"]; f = sur(torch.exp(z).unsqueeze(0)).squeeze(0)[:6]"
          },
          {
            "line": 58,
            "text": "        return -(-0.5 * (((f - yt) / yt) ** 2).sum() / 1e-3 - 0.5 * (z ** 2).sum() / SIG_N ** 2)"
          },
          {
            "line": 59,
            "text": "    torch.manual_seed(seed)"
          },
          {
            "line": 60,
            "text": "    mc = MCMC(NUTS(potential_fn=U, target_accept_prob=0.8), num_samples=nsamp, warmup_steps=500,"
          },
          {
            "line": 61,
            "text": "              initial_params={\"z\": torch.log(torch.tensor(init, dtype=torch.float32))}, disable_progbar=True)"
          },
          {
            "line": 62,
            "text": "    t = time.time(); mc.run(); dt = time.time() - t"
          },
          {
            "line": 63,
            "text": "    th = torch.exp(mc.get_samples()[\"z\"])"
          },
          {
            "line": 64,
            "text": "    try: ap = float(np.mean(mc.diagnostics()[\"acceptance rate\"][\"z\"]))"
          },
          {
            "line": 65,
            "text": "    except Exception: ap = 0.8"
          },
          {
            "line": 66,
            "text": "    return th, dt, ap"
          },
          {
            "line": 67,
            "text": ""
          },
          {
            "line": 68,
            "text": "inits = [R.FIELD_FASTMEAN, np.ones(6), (np.array(R.FIELD_FASTMEAN) * 1.3)]"
          },
          {
            "line": 69,
            "text": "nuts_chains = []"
          },
          {
            "line": 70,
            "text": "for ci, init in enumerate(inits):"
          },
          {
            "line": 71,
            "text": "    th, dt, ap = nuts_narrow(init, 500, seed=42 + ci)"
          },
          {
            "line": 72,
            "text": "    nuts_chains.append(th.numpy())"
          },
          {
            "line": 73,
            "text": "    if ci == 0:"
          },
          {
            "line": 74,
            "text": "        t_nu, ess_nu, mean_nu = dt, float(R.effective_sample_size(th).min()), th.numpy().mean(0)"
          },
          {
            "line": 75,
            "text": "        print(f\"[F1] NUTS: ESS_min={ess_nu:.1f} time={dt:.1f}s AR~{ap:.2f} mean e1={mean_nu[0]:.2f}\", flush=True)"
          }
        ]
      }
    ]
  },
